{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Threads Session Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Otomatis kirim sessionid Instagram ke aplikasi Threads setiap kali kamu login ulang, supaya tidak perlu salin manual lagi.",
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://threads.wandalo.dev/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Threads Session Sync",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs"
  ],
  "version": "1.1"
}